# ==============================================================================
# Califnco Round 1 Technical Assignment — Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Configuration (Shared between Mobile, Admin, and Seeder)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyPlaceholder
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=califnco-water.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=califnco-water
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=califnco-water.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyPlaceholder
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=califnco-water.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=califnco-water
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=califnco-water.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Firebase Admin SDK Service Account (Base64 or JSON path for trusted server operations)
FIREBASE_SERVICE_ACCOUNT_KEY=

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Test Mode)
# ------------------------------------------------------------------------------
# Test Key ID (Used in mobile & admin checkout UI)
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Test Key Secret (Kept strictly on backend for HMAC-SHA256 signature verification)
RAZORPAY_KEY_SECRET=YourRazorpayTestSecretKeyHere

# ------------------------------------------------------------------------------
# 3. AI Automation: Instagram Daily Publishing (n8n & Dry-Run Script)
# ------------------------------------------------------------------------------
# Google Sheets Spreadsheet ID and Range
GOOGLE_SHEETS_SPREADSHEET_ID=1A2B3C4D5E6F7G8H9I_YourSheetIdHere
GOOGLE_SHEETS_SHEET_NAME=Products_Catalog

# AI Text Generation (Gemini or OpenAI)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere

# AI Image Generation (Stability AI / OpenAI DALL-E / Pollinations)
STABILITY_API_KEY=sk-YourStabilityApiKeyHere

# Public Image Hosting (Imgur or Cloudinary for staging before Meta container ingest)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Meta Instagram Graph API
# Note: Requires a Facebook App, Instagram Professional (Business or Creator) Account,
# connected to a Facebook Page with instagram_content_publish permission.
META_PAGE_ACCESS_TOKEN=EAAGYourLongLivedMetaGraphPageAccessTokenHere
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000

# ------------------------------------------------------------------------------
# 4. Bonus: WAHA (WhatsApp HTTP API) Configuration
# ------------------------------------------------------------------------------
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
WAHA_API_KEY=secret_waha_api_key_here

# ------------------------------------------------------------------------------
# 5. Push, Email & SMS Notifications
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=AAAA...YourFCMServerKeyHere
RESEND_API_KEY=re_YourResendApiKeyHere
EMAIL_FROM="Califnco Support <support@califnco.com>"
TWILIO_ACCOUNT_SID=ACYourTwilioAccountSid
TWILIO_AUTH_TOKEN=YourTwilioAuthToken
TWILIO_PHONE_NUMBER=+1234567890
